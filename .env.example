# Copy to .env. Real environment variables override this file; set ENV_FILE=/path to use another file.
# Single-user login
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
# Random long secret used to sign session cookies
# Must be at least 32 characters (e.g. `openssl rand -hex 32`); the server refuses to start otherwise
SESSION_SECRET=change-me-too-please-generate-a-long-random-value
# Session cookie Secure flag: true | false | empty = auto (https or X-Forwarded-Proto: https)
COOKIE_SECURE=
# Reverse proxies in front of dashpod that append to X-Forwarded-For (Vercel/nginx/Cloudflare: 1).
# 0 = ignore the header. Wrong values let attackers dodge the login throttle or lock everyone out.
TRUSTED_PROXY_HOPS=0
# https agents are accepted with self-signed certificates by default; set true to require a valid cert
AGENT_TLS_VERIFY=
# Session lifetime in hours (default 12)
SESSION_MAX_AGE_HOURS=12

# Storage backend for node list + container configs: local | s3
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data

# Only used when STORAGE_TYPE=s3
S3_BUCKET=
S3_REGION=us-east-1
# Leave empty for AWS S3; set for S3-compatible providers (MinIO, R2, etc.)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# "true" for S3-compatible providers that need path-style addressing
S3_FORCE_PATH_STYLE=
